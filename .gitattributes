# Normalize line endings on commit; batch and PowerShell scripts ship as CRLF.
* text=auto
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.py text eol=lf
*.md text eol=lf
*.html text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.png binary
*.jpg binary
*.webp binary
*.gif binary
*.svg text eol=lf
*.sh text eol=lf

# Left out of release archives (git archive).
.github export-ignore
